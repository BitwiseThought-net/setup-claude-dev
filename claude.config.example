# --- Server Connection Settings ---
# The IP address of your Docker server running Ollama/LiteLLM
REMOTE_SERVER_IP="192.168.1.XX"
REMOTE_SERVER_PORT="4000"

# --- API Keys ---
# 'ollama' is the standard dummy key for local LiteLLM setups
LOCAL_API_KEY="ollama"

# (Optional) Your real Anthropic key for "Official Mode"
OFFICIAL_API_KEY=""

# --- Model Settings ---
# Must match a model you have pulled in Ollama
LOCAL_MODEL_NAME="qwen2.5-coder:14b"

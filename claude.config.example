# --- Server Connection Settings ---
# The IP address of your Docker server running Ollama/LiteLLM
REMOTE_SERVER_IP="192.168.1.XX"
REMOTE_SERVER_PORT="4000"

# (Optional) Protocol to use when talking to REMOTE_SERVER_IP:REMOTE_SERVER_PORT.
# Defaults to "http" if omitted, which matches a typical local-network Ollama/LiteLLM setup.
# Set to "https" if your server sits behind a TLS-terminated reverse proxy (e.g. nginx),
# otherwise you'll see "plain HTTP request was sent to HTTPS port" errors.
# REMOTE_SERVER_PROTOCOL="http"

# --- API Keys ---
# 'ollama' is the standard dummy key for local LiteLLM setups
LOCAL_API_KEY="ollama"

# (Optional) Your real Anthropic key for "Official Mode"
OFFICIAL_API_KEY=""

# --- Model Settings ---
# Must match a model you have pulled in Ollama
LOCAL_MODEL_NAME="qwen2.5-coder:14b"
